# Root Docker Compose variables. Copy to .env before running docker compose.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Seatalk QR Login Integration
SEATALK_APP_ID=your_seatalk_app_id
SEATALK_APP_SECRET=your_seatalk_app_secret
SEATALK_REDIRECT_URI=https://your-domain.com/api/auth/seatalk/callback
