APP_NAME="SOC 5 Outbound API"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://192.168.1.25:5173
LOG_CHANNEL=stack
LOG_STACK=stderr,sentry_logs
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_CA_BUNDLE=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional absolute CA bundle path for PHP cURL TLS verification.
# Leave empty when the host PHP installation has a configured CA store.
SUPABASE_CA_BUNDLE=
SUPABASE_CONNECT_TIMEOUT=5
SUPABASE_TIMEOUT=10
SUPABASE_TOKEN_CACHE_TTL=30
# Redis is optional. Leave these on file/sync unless you have a real Redis instance.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_CONNECTION=default
SESSION_STORE=default
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true
ADMIN_EMAILS=

# Seatalk QR Login Integration
SEATALK_APP_ID=your_seatalk_app_id
SEATALK_APP_SECRET=your_seatalk_app_secret
SEATALK_REDIRECT_URI=https://your-domain.com/api/auth/seatalk/callback

REDIS_CLIENT=predis
REDIS_HOST=
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_SCHEME=tls
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_CACHE_CONNECTION=cache
REDIS_QUEUE_CONNECTION=queue
REDIS_SESSION_CONNECTION=session
